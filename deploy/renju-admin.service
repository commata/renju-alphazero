# Independent admin server; never opens a public port or restarts renju-web.
[Unit]
Description=Renju read-only admin server
After=network.target renju-web.service
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/renju-alphazero
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=src
EnvironmentFile=/etc/renju-admin.env
ExecStart=/home/deploy/renju-alphazero/.venv-ser5/bin/python scripts/run_web_admin.py --db data/renju_web.db --port 8010
Restart=on-failure
RestartSec=5
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0077

[Install]
WantedBy=multi-user.target
